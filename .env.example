PORT=3000
LOG_LEVEL=INFO

# API Keys for LLM Providers
OPENAI_API_KEY=sk-your-openai-key-here
CLAUDE_API_KEY=sk-ant-your-claude-key-here
GEMINI_API_KEY=your-gemini-key-here
KIMI_API_KEY=sk-your-kimi-key-here
MISTRAL_API_KEY=sk-your-mistral-key-here
XAI_API_KEY=sk-your-xai-key-here
GROQ_API_KEY=gsk_your-groq-key-here
SILICONFLOW_API_KEY=sk-your-siliconflow-key-here
STEPFUN_API_KEY=sk-your-stepfun-key-here
TOGETHER_API_KEY=sk-your-together-key-here
CEREBRAS_API_KEY=sk-your-cerebras-key-here

# pricing config (page scrape uses free Jina Reader + Firecrawl keyless; only LLM key required)
LLM_API_KEY=sk-your-llm-key-here
LLM_BASE_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini

# Notification Webhooks
WEWORK_BOT_KEY_CHANGES=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=your-wework-key
LARK_BOT_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/your-lark-key
